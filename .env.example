# Copy to .env and fill in. .env is gitignored and must never be committed.

# PageSpeed Insights. Free, 25000 requests a day.
# Google Cloud project: mizan-tools
# console.cloud.google.com -> APIs and Services -> Credentials -> API key
PAGESPEED_API_KEY=

# Google Places, for the Business Profile checks. Needs billing enabled; at a few reports a week
# it stays inside the free tier.
PLACES_API_KEY=

# Email, for --email and for intake. Every message goes to mo@mizangroupllc.com, which is hard-coded in
# mailer.py and cannot be changed here; the site owner is never emailed.
# SMTP_PASSWORD is a Google app password (Google Account -> Security -> App passwords),
# not the account password.
SMTP_USERNAME=mo@mizangroupllc.com
SMTP_PASSWORD=

# Webflow, for intake: reads submissions to the form on /digital. A token with read access to forms only.
WEBFLOW_API_TOKEN=

# Optional, Windows only: where WeasyPrint finds Pango for --pdf.
# Leave empty if MSYS2 is in its default place (C:\msys64\ucrt64\bin).
WEASYPRINT_DLL_DIRECTORIES=
