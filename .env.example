# Copy to .env and fill in. .env is gitignored and must never be committed.

# PageSpeed Insights. Free, 25000 requests a day.
# Google Cloud project: mizan-tools
# console.cloud.google.com -> APIs and Services -> Credentials -> API key
PAGESPEED_API_KEY=

# Google Places, for the Business Profile check. Needs billing enabled.
# Not required yet.
PLACES_API_KEY=
